# Lite SQLite example. Replace CHECK_UPSTREAM_TAG. Check upstream docs.
# Postgres, nginx, and the checklist are in the full pack.

COMPOSE_PROJECT_NAME=n8n-example
N8N_IMAGE=docker.n8n.io/n8nio/n8n:CHECK_UPSTREAM_TAG
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=example-encryption-key
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
